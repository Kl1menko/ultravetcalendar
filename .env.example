NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Ролі лікарів керуються в таблиці `profiles` у БД (єдине джерело прав).
# Seed і RLS — supabase/add-roles-tables.sql. У коді — лише чисті хелпери
# canSeeX(role) у src/lib/doctors.ts, без власного джерела істини.

# Web Push (PWA-сповіщення). Публічний VAPID-ключ — у клієнт (підписка).
# Згенерувати пару: npx web-push generate-vapid-keys
# Приватний ключ НЕ сюди — він у секрети Supabase Edge Function (розсилка).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
